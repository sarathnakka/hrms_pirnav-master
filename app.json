{
  "expo": {
    "owner": "pirnav-software-solutions-pvt-ltd",
    "name": "PIRNAV HRMS",
    "slug": "hrms-pirnav",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/pirnav-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/app-icon.png",
      "bundleIdentifier": "com.pirnav.hrms"
    },
    "android": {
      "package": "com.pirnav.hrms",
      "icon": "./assets/app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#FFFFFF",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow PIRNAV HRMS to use the camera to capture employee documents."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a6cc1c31-570d-4288-92b7-62c7937ff306"
      }
    }
  }
}
